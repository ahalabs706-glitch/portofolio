
FROM node:24-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/api/prisma/schema.prisma apps/api/prisma/schema.prisma

RUN npm ci

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api

RUN npm run build --workspace @devfolio/shared \
  && npm run build --workspace @devfolio/api

# Remove development dependencies before production image
RUN npm prune --omit=dev


FROM node:24-alpine

ENV NODE_ENV=production

WORKDIR /workspace

COPY --from=build --chown=node:node /workspace /workspace

# npm is not needed at runtime; the base image's bundled npm carries known CVEs.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER node

WORKDIR /workspace/apps/api

EXPOSE 4000

CMD ["sh", "-c", "/workspace/node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma && node dist/server.js"]
